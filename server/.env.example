# Skopiuj ten plik do .env (bez .example).
# Baza PostgreSQL uruchamiana lokalnie w Dockerze: `docker compose up -d`
DATABASE_URL="postgresql://cubeverse:cubeverse@localhost:5432/cubeverse?schema=public"

# Sekret do podpisywania tokenów logowania — MUSI być własny i losowy (min. 32 znaki).
# Z tą przykładową wartością serwer celowo NIE wystartuje. Wygeneruj nowy:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="zmien-mnie-na-cos-dlugiego-i-losowego"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development

# Za reverse proxy (Render, Railway, nginx…) ustaw liczbę proxy przed serwerem,
# np. 1 — inaczej limiter prób logowania widzi IP proxy zamiast IP użytkownika
# i jedna osoba zgadująca hasło zablokowałaby logowanie wszystkim.
# TRUST_PROXY=1
